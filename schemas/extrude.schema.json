{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohanCrazy2005/PyModeler/schemas/extrude.schema.json",
  "title": "ExtrudeFeature",
  "description": "Parametric Extrude feature: sweeps a sketch profile by a distance to create a solid.",
  "type": "object",
  "required": ["id", "type", "sketch_id", "distance"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique feature identifier"
    },
    "type": {
      "type": "string",
      "const": "extrude",
      "description": "Feature type discriminator"
    },
    "name": {
      "type": "string",
      "default": "Extrude",
      "description": "Human-readable feature name"
    },
    "sketch_id": {
      "type": "string",
      "minLength": 1,
      "description": "ID of the driving Sketch"
    },
    "distance": {
      "description": "Extrusion distance: numeric value or parameter name / expression string",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "direction": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3,
      "description": "Optional extrusion direction vector (defaults to sketch plane normal)"
    },
    "symmetric": {
      "type": "boolean",
      "default": false,
      "description": "If true, extrude equally in both directions (distance is total or half — see implementation)"
    },
    "operation": {
      "type": "string",
      "enum": ["new", "join", "cut", "intersect"],
      "default": "new",
      "description": "Boolean operation intent (currently only 'new' is implemented)"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
