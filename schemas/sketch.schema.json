{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohanCrazy2005/PyModeler/schemas/sketch.schema.json",
  "title": "Sketch",
  "description": "2D parametric sketch: entities, geometric constraints, and dimensions. Source of truth for sketch data in PyModeler.",
  "type": "object",
  "required": ["entities"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique sketch identifier"
    },
    "name": {
      "type": "string",
      "default": "Sketch",
      "description": "Human-readable sketch name"
    },
    "plane": {
      "type": "object",
      "description": "Sketch plane definition (XY by default). Origin and two axes in 3D world space.",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" },
          "default": [0.0, 0.0, 0.0]
        },
        "x_axis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" },
          "default": [1.0, 0.0, 0.0]
        },
        "y_axis": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" },
          "default": [0.0, 1.0, 0.0]
        }
      }
    },
    "entities": {
      "type": "array",
      "description": "Geometric entities that make up the sketch",
      "items": { "$ref": "#/$defs/entity" }
    },
    "constraints": {
      "type": "array",
      "description": "Geometric constraints between entities",
      "default": [],
      "items": { "$ref": "#/$defs/constraint" }
    },
    "dimensions": {
      "type": "array",
      "description": "Driving or driven dimensions",
      "default": [],
      "items": { "$ref": "#/$defs/dimension" }
    },
    "metadata": {
      "type": "object",
      "description": "Free-form metadata",
      "additionalProperties": true
    }
  },
  "$defs": {
    "entity_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for an entity within the sketch"
    },
    "entity": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/entity_id" },
        "type": {
          "type": "string",
          "enum": ["point", "line", "circle", "arc"]
        },
        "construction": {
          "type": "boolean",
          "default": false,
          "description": "If true, entity is construction geometry"
        },
        "fixed": {
          "type": "boolean",
          "default": false,
          "description": "If true, point is fixed in place"
        },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "start_point": { "$ref": "#/$defs/entity_id" },
        "end_point": { "$ref": "#/$defs/entity_id" },
        "center": { "$ref": "#/$defs/entity_id" },
        "radius": { "type": "number", "minimum": 0 },
        "start_angle": { "type": "number" },
        "end_angle": { "type": "number" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "point" } } },
          "then": { "required": ["x", "y"] }
        },
        {
          "if": { "properties": { "type": { "const": "line" } } },
          "then": { "required": ["start_point", "end_point"] }
        },
        {
          "if": { "properties": { "type": { "const": "circle" } } },
          "then": { "required": ["center", "radius"] }
        },
        {
          "if": { "properties": { "type": { "const": "arc" } } },
          "then": { "required": ["center", "radius", "start_angle", "end_angle"] }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "required": ["id", "type", "entities"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "coincident",
            "horizontal",
            "vertical",
            "parallel",
            "perpendicular",
            "equal",
            "tangent",
            "midpoint",
            "fixed",
            "concentric",
            "collinear"
          ]
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entity_id" }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["id", "type", "value", "entities"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["length", "distance", "radius", "diameter", "angle"]
        },
        "value": {
          "oneOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entity_id" }
        },
        "driven": {
          "type": "boolean",
          "default": false
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
