{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohanCrazy2005/PyModeler/schemas/toolpath.schema.json",
  "title": "ToolpathJob",
  "description": "Early CAM stub: a simple 2D rectangular pocket or contour toolpath that can emit G-code. Schema-validated manufacturing helper.",
  "type": "object",
  "required": [
    "operation",
    "width",
    "height",
    "depth",
    "tool_diameter"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "default": "Toolpath"
    },
    "operation": {
      "type": "string",
      "enum": [
        "pocket",
        "contour"
      ],
      "description": "pocket = clear interior; contour = follow boundary"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Feature width in X (mm)"
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Feature height in Y (mm)"
    },
    "depth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Cut depth (positive number, applied as negative Z)"
    },
    "tool_diameter": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "strategy": {
      "type": "string",
      "enum": [
        "concentric",
        "zigzag"
      ],
      "default": "concentric",
      "description": "Pocket clearing pattern: concentric rectangles or parallel zig-zag lines"
    },
    "stepover_fraction": {
      "type": "number",
      "minimum": 0.1,
      "maximum": 0.95,
      "default": 0.5
    },
    "depth_of_cut": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 1.0
    },
    "feed": {
      "type": "number",
      "minimum": 0,
      "default": 500
    },
    "plunge_feed": {
      "type": "number",
      "minimum": 0,
      "default": 150
    },
    "safe_z": {
      "type": "number",
      "default": 5.0
    },
    "spindle_speed": {
      "type": "integer",
      "minimum": 0,
      "default": 12000
    },
    "origin_x": {
      "type": "number",
      "default": 0
    },
    "origin_y": {
      "type": "number",
      "default": 0
    },
    "unit": {
      "type": "string",
      "default": "mm"
    },
    "gcode": {
      "type": "string",
      "description": "Generated G-code text (populated by generate())"
    },
    "estimated_length": {
      "type": "number",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "lead_in_length": {
      "type": "number",
      "minimum": 0,
      "default": 0.0,
      "description": "Optional linear lead-in length (mm). 0 = disabled. Approach from outside then cut to path entry."
    },
    "lead_out_length": {
      "type": "number",
      "minimum": 0,
      "default": 0.0,
      "description": "Optional linear lead-out length (mm). 0 = disabled. Extend past exit."
    },
    "corner_radius": {
      "type": "number",
      "minimum": 0,
      "default": 0.0,
      "description": "Optional corner radius (mm) for rectangular paths. 0 = sharp corners (G01 only). >0 emits G02/G03 arcs at corners."
    }
  }
}
