{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohanCrazy2005/PyModeler/schemas/bom.schema.json",
  "title": "BOM",
  "description": "A basic Bill of Materials generated from Parts or an Assembly. Lists unique parts with summed quantities, resolved materials, and optional bounding-box size. Manufacturing helper inspired by Fusion/Onshape/Mozaik.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "default": "BOM"
    },
    "source": {
      "type": "string",
      "description": "Origin of the BOM: 'parts' or 'assembly'",
      "enum": ["parts", "assembly"]
    },
    "items": {
      "type": "array",
      "description": "One entry per unique part_id (quantities summed)",
      "items": {
        "type": "object",
        "required": ["part_id", "name", "quantity"],
        "additionalProperties": true,
        "properties": {
          "part_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "material": {
            "description": "Raw material value from the Part (string, object, or null)",
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": true },
              { "type": "null" }
            ]
          },
          "material_name": {
            "type": ["string", "null"],
            "description": "Resolved display name (from MaterialStore when possible)"
          },
          "material_id": {
            "type": ["string", "null"]
          },
          "size": {
            "type": "object",
            "description": "Optional axis-aligned bounding box size of the recomputed body",
            "properties": {
              "width": { "type": "number" },
              "depth": { "type": "number" },
              "height": { "type": "number" },
              "dx": { "type": "number" },
              "dy": { "type": "number" },
              "dz": { "type": "number" },
              "unit": { "type": "string", "default": "mm" }
            },
            "additionalProperties": true
          },
          "has_geometry": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
