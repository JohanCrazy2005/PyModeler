{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohanCrazy2005/PyModeler/schemas/nesting_job.schema.json",
  "title": "NestingJob",
  "description": "A rectangular nesting job: stock sheet definition, parts to place, and computed sheet layouts with yield. Early Mozaik-inspired manufacturing helper.",
  "type": "object",
  "required": ["sheet_width", "sheet_height", "parts"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "default": "Nesting Job"
    },
    "sheet_width": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Usable sheet width (after trim if applied)"
    },
    "sheet_height": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Usable sheet height (after trim if applied)"
    },
    "sheet_sizes": {
      "type": "array",
      "description": "Optional list of available stock sheet sizes. When present, pack() prefers the smallest size that can accept the next part (falling back to the primary sheet_width/height).",
      "items": {
        "type": "object",
        "required": ["width", "height"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "quantity_available": { "type": "integer", "minimum": 0, "description": "Optional stock limit (unlimited if omitted)" }
        }
      }
    },
    "kerf": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Minimum spacing between parts (tool diameter / saw kerf + clearance)"
    },
    "trim": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Optional edge margin reserved on each side of the sheet"
    },
    "unit": {
      "type": "string",
      "default": "mm"
    },
    "parts": {
      "type": "array",
      "description": "Parts to nest (quantity expanded or kept as quantity field)",
      "items": {
        "type": "object",
        "required": ["width", "height", "quantity"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "quantity": { "type": "integer", "minimum": 1 },
          "can_rotate": { "type": "boolean", "default": true },
          "material": { "type": ["string", "null"] },
          "part_id": { "type": "string" },
          "comment": { "type": "string" }
        }
      }
    },
    "layouts": {
      "type": "array",
      "description": "Computed sheet layouts (populated by pack())",
      "items": {
        "type": "object",
        "properties": {
          "sheet_index": { "type": "integer", "minimum": 0 },
          "sheet_width": { "type": "number" },
          "sheet_height": { "type": "number" },
          "sheet_name": { "type": "string" },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number" },
                "height": { "type": "number" },
                "part_id": { "type": "string" },
                "name": { "type": "string" },
                "rotated": { "type": "boolean", "default": false },
                "quantity_index": { "type": "integer" }
              },
              "additionalProperties": true
            }
          },
          "used_area": { "type": "number" },
          "yield": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "sheets_used": {
      "type": "integer",
      "minimum": 0
    },
    "total_yield": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Overall material yield (0\u20131)"
    },
    "total_part_area": {
      "type": "number"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
