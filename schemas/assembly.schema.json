{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohanCrazy2005/PyModeler/schemas/assembly.schema.json",
  "title": "Assembly",
  "description": "A simple Assembly container that holds instances of Parts (or future sub-assemblies) with transforms and basic mates.",
  "type": "object",
  "required": ["instances"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "default": "Assembly"
    },
    "instances": {
      "type": "array",
      "description": "Ordered list of part instances placed in the assembly",
      "items": {
        "type": "object",
        "required": ["part_id"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "part_id": {
            "type": "string",
            "minLength": 1,
            "description": "Identifier of the referenced Part"
          },
          "transform": {
            "type": "object",
            "description": "Placement transform (location, rotation Euler XYZ radians, scale)",
            "additionalProperties": false,
            "properties": {
              "location": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "scale": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "grounded": {
            "type": "boolean",
            "default": false,
            "description": "Whether this instance is fixed in place"
          },
          "visible": {
            "type": "boolean",
            "default": true
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "mates": {
      "type": "array",
      "description": "List of mates that constrain relative placement of instances",
      "default": [],
      "items": {
        "type": "object",
        "required": ["instance_a", "instance_b", "type"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["rigid", "fastened", "revolute", "slider"],
            "description": "Mate type. rigid/fastened lock relative transform (0 DOF). revolute/slider are stubs that currently apply fixed offset (full DOF handling later)."
          },
          "instance_a": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the first instance"
          },
          "instance_b": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the second instance"
          },
          "offset": {
            "type": "object",
            "description": "Desired relative transform of B with respect to A (location + rotation for rigid/fastened; stubs for others)",
            "additionalProperties": false,
            "properties": {
              "location": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "scale": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
