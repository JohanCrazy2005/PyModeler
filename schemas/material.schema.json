{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JohanCrazy2005/PyModeler/schemas/material.schema.json",
  "title": "MaterialStore",
  "description": "Library of materials and stock definitions for Parts (sheet, solid, linear). Supports manufacturing-relevant attributes used by cut lists and BOM.",
  "type": "object",
  "required": ["materials"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional store identifier"
    },
    "name": {
      "type": "string",
      "default": "Materials",
      "description": "Human-readable name for the material library"
    },
    "materials": {
      "type": "array",
      "description": "List of material / stock definitions",
      "items": { "$ref": "#/$defs/material" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name, e.g. 'Baltic Birch 18mm'"
        },
        "category": {
          "type": "string",
          "enum": ["wood", "metal", "plastic", "composite", "other"],
          "default": "other",
          "description": "Broad material category"
        },
        "type": {
          "type": "string",
          "enum": ["sheet", "solid", "linear", "other"],
          "default": "sheet",
          "description": "Stock form: sheet (panel), solid (block), linear (extrusion/bar)"
        },
        "thickness": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Primary thickness in unit (mm by default); critical for panel stock"
        },
        "width": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional stock width"
        },
        "length": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional stock length"
        },
        "density": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Density in kg/m³ (optional, for mass estimates)"
        },
        "color": {
          "type": ["string", "null"],
          "description": "Optional hex color for visualization, e.g. '#c4a35a'"
        },
        "grain": {
          "type": "boolean",
          "default": false,
          "description": "Whether grain direction is manufacturing-relevant"
        },
        "unit": {
          "type": "string",
          "default": "mm",
          "description": "Length unit for thickness/width/length"
        },
        "cost_per_unit": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Optional cost per unit area/volume/length for later BOM"
        },
        "comment": {
          "type": "string",
          "description": "Free-form note"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
